# Copy to runtime.env. This contains only the local API token, never provider keys.
# Match MOOLAI_BACKEND_TOKEN in backend/.env.
MOOLAI_BACKEND_TOKEN=
MOOLAI_BACKEND_URL=http://127.0.0.1:8000

# Optional: installed ripgrep executable for selected-folder read-only tools.
# MOOLAI_RG_PATH=/opt/homebrew/bin/rg
