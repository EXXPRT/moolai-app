{
  "version": 1,
  "scope": "Synthetic text only; expected outcomes fixed before live dispatch. Independent cases, no pending offers. Strict and exploratory cases scored separately.",
  "cases": [
    {
      "id": "start-direct",
      "category": "start",
      "scoring": "strict",
      "text": "Moo, help me organize these notes.",
      "activeConversation": false,
      "expectedRoutes": [
        "start_agent"
      ],
      "expectedAction": "start"
    },
    {
      "id": "start-notes-only",
      "category": "start",
      "scoring": "strict",
      "text": "Hey Moo, explain the main idea using only my notes.",
      "activeConversation": false,
      "expectedRoutes": [
        "start_agent"
      ],
      "expectedAction": "start"
    },
    {
      "id": "start-sentence-break",
      "category": "start",
      "scoring": "strict",
      "text": "Moo. Can you summarize what I just said?",
      "activeConversation": false,
      "expectedRoutes": [
        "start_agent"
      ],
      "expectedAction": "start"
    },
    {
      "id": "start-question",
      "category": "start",
      "scoring": "strict",
      "text": "Moo, why does this method work?",
      "activeConversation": false,
      "expectedRoutes": [
        "start_agent"
      ],
      "expectedAction": "start"
    },
    {
      "id": "end-finish",
      "category": "end",
      "scoring": "strict",
      "text": "Moo, finish conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent"
      ],
      "expectedAction": "end"
    },
    {
      "id": "end-legacy",
      "category": "end",
      "scoring": "strict",
      "text": "Moo, end conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent"
      ],
      "expectedAction": "end"
    },
    {
      "id": "end-close",
      "category": "end",
      "scoring": "strict",
      "text": "Please close the conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent"
      ],
      "expectedAction": "end"
    },
    {
      "id": "end-broken-name",
      "category": "end",
      "scoring": "strict",
      "text": "Boo.\n Finish conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent"
      ],
      "expectedAction": "end",
      "note": "Synthetic reproduction of a previously observed ASR error; no recording is read."
    },
    {
      "id": "end-paraphrase",
      "category": "end",
      "scoring": "strict",
      "text": "We can end our conversation now, Moo.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent"
      ],
      "expectedAction": "end"
    },
    {
      "id": "end-mixed-content",
      "category": "end",
      "scoring": "strict",
      "text": "Keep the first idea separate. Moo, finish conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent"
      ],
      "expectedAction": "end",
      "note": "Closing should preserve substantive content and pending-work handling; fixture response finishes immediately."
    },
    {
      "id": "dictate-thought",
      "category": "dictate",
      "scoring": "strict",
      "text": "The next experiment should compare two groups.",
      "activeConversation": false,
      "expectedRoutes": [
        "dictate"
      ],
      "expectedAction": "summary"
    },
    {
      "id": "dictate-question",
      "category": "dictate",
      "scoring": "strict",
      "text": "Why does this method work?",
      "activeConversation": false,
      "expectedRoutes": [
        "dictate"
      ],
      "expectedAction": "summary"
    },
    {
      "id": "dictate-doubt",
      "category": "dictate",
      "scoring": "strict",
      "text": "I do not understand this part.",
      "activeConversation": false,
      "expectedRoutes": [
        "dictate"
      ],
      "expectedAction": "summary"
    },
    {
      "id": "dictate-action",
      "category": "dictate",
      "scoring": "strict",
      "text": "I need to revisit the introduction tomorrow.",
      "activeConversation": false,
      "expectedRoutes": [
        "dictate"
      ],
      "expectedAction": "summary"
    },
    {
      "id": "dictate-quoted-start",
      "category": "dictate",
      "scoring": "strict",
      "text": "The example phrase is \"Moo, help me organize these notes.\"",
      "activeConversation": false,
      "expectedRoutes": [
        "dictate"
      ],
      "expectedAction": "summary"
    },
    {
      "id": "dictate-move",
      "category": "dictate",
      "scoring": "strict",
      "text": "Move these ideas into the second paragraph.",
      "activeConversation": false,
      "expectedRoutes": [
        "dictate"
      ],
      "expectedAction": "summary",
      "note": "No direct Moo invocation; should not start an agent task."
    },
    {
      "id": "unclear-start-or-stop",
      "category": "unclear",
      "scoring": "strict",
      "text": "Moo, start or stop the conversation? I have not decided which.",
      "activeConversation": false,
      "expectedRoutes": [
        "unclear"
      ],
      "expectedAction": "clarify"
    },
    {
      "id": "unclear-finish-or-continue",
      "category": "unclear",
      "scoring": "strict",
      "text": "Moo, finish or keep going. I cannot decide which one I want.",
      "activeConversation": true,
      "expectedRoutes": [
        "unclear"
      ],
      "expectedAction": "clarify"
    },
    {
      "id": "unclear-fragment",
      "category": "unclear",
      "scoring": "exploratory",
      "text": "Moo, the... no, maybe... start... finish...",
      "activeConversation": false,
      "expectedRoutes": [
        "unclear"
      ],
      "expectedAction": "clarify",
      "note": "Incomplete simulated ASR; tests abstention without inventing intent."
    },
    {
      "id": "unclear-no-referent",
      "category": "unclear",
      "scoring": "exploratory",
      "text": "That one, or the other one... I cannot tell you which.",
      "activeConversation": false,
      "expectedRoutes": [
        "unclear"
      ],
      "expectedAction": "clarify",
      "note": "Could be retained as dictation; report taxonomy separately from safe abstention."
    },
    {
      "id": "invalid-negated-close",
      "category": "invalid",
      "scoring": "strict",
      "text": "Moo, do not finish conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "no_action"
      ],
      "expectedAction": "keep_open"
    },
    {
      "id": "invalid-quoted-close",
      "category": "invalid",
      "scoring": "strict",
      "text": "The phrase \"Moo, end conversation\" is just an example.",
      "activeConversation": true,
      "expectedRoutes": [
        "dictate",
        "no_action"
      ],
      "expectedAction": "keep_open"
    },
    {
      "id": "invalid-hypothetical-close",
      "category": "invalid",
      "scoring": "strict",
      "text": "If I said \"Moo, finish conversation\", what would happen?",
      "activeConversation": true,
      "expectedRoutes": [
        "dictate",
        "no_action"
      ],
      "expectedAction": "keep_open"
    },
    {
      "id": "invalid-keep-open",
      "category": "invalid",
      "scoring": "strict",
      "text": "Keep this conversation open.",
      "activeConversation": true,
      "expectedRoutes": [
        "no_action"
      ],
      "expectedAction": "keep_open"
    },
    {
      "id": "invalid-retracted-close",
      "category": "invalid",
      "scoring": "strict",
      "text": "Moo, finish conversation. Actually, keep it open.",
      "activeConversation": true,
      "expectedRoutes": [
        "no_action"
      ],
      "expectedAction": "keep_open"
    },
    {
      "id": "invalid-close-while-idle",
      "category": "invalid",
      "scoring": "strict",
      "text": "Moo, finish conversation.",
      "activeConversation": false,
      "expectedRoutes": [
        "no_action",
        "unclear"
      ],
      "expectedAction": "keep_open",
      "note": "No active conversation exists; must not create a new one."
    },
    {
      "id": "noisy-start-boo",
      "category": "noisy",
      "scoring": "exploratory",
      "text": "Boo, help me organize my notes.",
      "activeConversation": false,
      "expectedRoutes": [
        "start_agent",
        "unclear"
      ],
      "expectedAction": "start",
      "note": "Simulated misheard direct address. Low-confidence clarification is safe; strict intended-action recovery is measured separately."
    },
    {
      "id": "noisy-start-move",
      "category": "noisy",
      "scoring": "exploratory",
      "text": "Move, help me organize my notes.",
      "activeConversation": false,
      "expectedRoutes": [
        "start_agent",
        "unclear"
      ],
      "expectedAction": "start",
      "note": "Contrast with the ordinary Move dictation case; no global alias rewrite."
    },
    {
      "id": "noisy-end-and",
      "category": "noisy",
      "scoring": "exploratory",
      "text": "Moo and the conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent",
        "unclear"
      ],
      "expectedAction": "end",
      "note": "Simulated end/and confusion; clarification is safe, intent recovery is not established by a safe abstention."
    },
    {
      "id": "noisy-end-mu",
      "category": "noisy",
      "scoring": "exploratory",
      "text": "Mu, end conversation.",
      "activeConversation": true,
      "expectedRoutes": [
        "end_agent",
        "unclear"
      ],
      "expectedAction": "end",
      "note": "Name spelling must not alone prevent plausible ending from reaching J1."
    },
    {
      "id": "bare-invocation",
      "category": "boundary",
      "scoring": "exploratory",
      "text": "Moo.",
      "activeConversation": false,
      "expectedRoutes": [
        "start_agent",
        "no_action",
        "unclear"
      ],
      "expectedAction": "start",
      "note": "Bare name behavior is not settled by current provider criteria requiring a substantive request; descriptive only."
    },
    {
      "id": "stop-playback-not-conversation",
      "category": "boundary",
      "scoring": "strict",
      "text": "Stop reading aloud.",
      "activeConversation": true,
      "expectedRoutes": [
        "no_action",
        "unclear"
      ],
      "expectedAction": "keep_open",
      "note": "Stopping playback is distinct from ending the conversation; this test only scores no unintended close."
    }
  ]
}
