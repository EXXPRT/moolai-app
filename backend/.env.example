# Copy to backend/.env. Never commit credentials.
TYPESAFE_API_KEY=
NEBIUS_API_KEY=
TAVILY_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
JEV_MODEL=jev-1.13.0
NEBIUS_SUMMARY_MODEL=nvidia/Nemotron-3_5-Lightning
# Nano remains configurable: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Reasoning-inclusive output bound (1200–8192); restart the backend after changes.
NEBIUS_SUMMARY_MAX_TOKENS=1200
# Organization only: provider-default reasoning plus structured topic summaries.
# Explicit range 4096–16384; no automatic increase or retry after failure.
NEBIUS_ORGANIZATION_MAX_TOKENS=8192
NEBIUS_AGENT_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Reasoning-inclusive response allowance (2400–8192). This deployment setting
# leaves more room for reasoning plus final text/narration; it is never retried
# or expanded automatically. Omitting it retains the library's 2400 default.
NEBIUS_AGENT_MAX_TOKENS=4096
NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
# Exact text/fields use the independently validated OCR profile; scenes keep VISION_MODEL.
NEBIUS_OCR_MODEL=zai-org/GLM-5.3-Flash
NEBIUS_OCR_REASONING_EFFORT=low
DATABASE_URL=postgresql://moolai:moolai@localhost:5432/moolai
# Local development API authentication; choose a random value.
MOOLAI_BACKEND_TOKEN=
